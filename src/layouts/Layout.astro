  /* Lives here rather than in a theme because every theme needs it: it
     carries text a title attribute alone does not give screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .activity-weight-segment,
  .activity-weight-callout,
  .activity-weight-legend-label,
  .activity-weight-legend-value {
    transition:
      opacity 0.2s ease,
      filter 0.2s ease,
      color 0.2s ease,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .activity-weight-distribution {
    &:has(.activity-weight-segment:hover, .activity-weight-legend-item:hover)
      :is(.activity-weight-segment, .activity-weight-legend-item > *) {
      opacity: 0.3;
      filter: saturate(0.4);
    }
    &:has(.is-contributors:hover) :is(.is-contributors, .is-contributors > *),
    &:has(.is-history:hover) :is(.is-history, .is-history > *),
    &:has(.is-activity:hover) :is(.is-activity, .is-activity > *),
    &:has(.is-stars:hover) :is(.is-stars, .is-stars > *),
    &:has(.is-forks:hover) :is(.is-forks, .is-forks > *),
    &:has(.is-issues:hover) :is(.is-issues, .is-issues > *),
    &:has(.is-free:hover) :is(.is-free, .is-free > *) {
      opacity: 1;
      filter: none;
      color: var(--text-primary, inherit);
    }
    &:has(.is-contributors:hover) .activity-weight-segment.is-contributors,
    &:has(.is-history:hover) .activity-weight-segment.is-history,
    &:has(.is-activity:hover) .activity-weight-segment.is-activity,
    &:has(.is-stars:hover) .activity-weight-segment.is-stars,
    &:has(.is-forks:hover) .activity-weight-segment.is-forks,
    &:has(.is-issues:hover) .activity-weight-segment.is-issues {
      filter: brightness(1.1) saturate(1.2);
      transform: var(--pop, none);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .activity-weight-segment,
    .activity-weight-callout,
    .activity-weight-legend-label,
    .activity-weight-legend-value {
      transition: none;
    }
